# ==========================================================
# Nemvai — ENV Template (Free Manual Deploy Ready)
# انسخ هذا الملف إلى .env وعبّئ القيم
# لا ترفع .env أبداً — محمي في .gitignore:10
# ==========================================================

# --- Flask Core — إجباري في الإنتاج ---
FLASK_ENV=production
# ولّد: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-64chars-min
JWT_SECRET_KEY=change-me-64chars-min-2

# --- Database — persistent switch (free SQLite / paid PostgreSQL) ---
# الخطة المجانية: اترك DATABASE_URL فارغاً → يستخدم sqlite:///arenax.db (instance/arenax.db)
# لتخزين ثابت على Render (إن ربطت قرصاً): استخدم مساراً مطلقاً:
# DATABASE_URL=sqlite:////data/nemvai.db  # يتطلب Disk mount at /data على Render
# للترقية إلى PostgreSQL (موثوق، لا يُمسح):
# DATABASE_URL=postgresql://user:pass@host:5432/nemvai
# ملاحظة: التطبيق يحول تلقائياً postgres:// → postgresql:// ويضبط pooling آمن

# --- Security (OWASP) ---
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
# Cookies: Secure=True + SameSite=Strict + HttpOnly تُفعّل تلقائياً في production

# --- Rate limiting ---
RATE_LIMIT_AUTH=5 per minute
RATE_LIMIT_API=60 per minute

# --- App ---
APP_NAME=Nemvai
# على Render ضع رابطك الحقيقي بعد الإنشاء:
FRONTEND_URL=https://nemvai.onrender.com
# محلياً:
# FRONTEND_URL=http://127.0.0.1:5000

# --- Gunicorn/Render ---
# Render يمرر PORT تلقائياً — gunicorn.conf.py يقرأه
PORT=8000
