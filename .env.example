# ==========================================================
# ArenaX Productivity Hub — ENV Template
# انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية
# لا ترفع .env أبداً إلى GitHub
# ==========================================================

# --- Flask Core ---
FLASK_ENV=production
SECRET_KEY=change-me-generate-strong-32+chars-random
JWT_SECRET_KEY=change-me-another-strong-64chars-random

# --- Database ---
# الافتراضي SQLite محلي. للإنتاج استخدم PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/arenax
DATABASE_URL=sqlite:///arenax.db

# --- Security ---
# مدة صلاحية التوكن (بالساعات)
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Rate limiting (طلبات / دقيقة)
RATE_LIMIT_AUTH=5 per minute
RATE_LIMIT_API=60 per minute

# --- App ---
APP_NAME=ArenaX Productivity Hub
FRONTEND_URL=http://localhost:5000
