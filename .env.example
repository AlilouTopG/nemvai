# ==========================================================
# Nemvai — ENV Template (Production Ready)
# انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية
# لا ترفع .env أبداً إلى GitHub — محمي في .gitignore:10
# ==========================================================

# --- Flask Core — إجباري في الإنتاج ---
FLASK_ENV=production
# ولّد مفاتيح قوية: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-strong-32+chars-random-min-48
JWT_SECRET_KEY=change-me-another-strong-64chars-random-min-48

# --- Database ---
# محلي (SQLite) — للتطوير فقط:
# DATABASE_URL=sqlite:///nemvai.db
# إنتاج (PostgreSQL على Render) — يُحقن تلقائياً عبر render.yaml:
DATABASE_URL=postgresql://user:pass@host:5432/nemvai

# --- Security (OWASP) ---
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
# في الإنتاج: Cookies تصبح Secure=True + SameSite=Strict + HttpOnly تلقائياً
# Headers: CSP/HSTS/DENY/nosniff/no-referrer-when-downgrade تُطبق على كل رد

# --- Rate limiting ---
RATE_LIMIT_AUTH=5 per minute
RATE_LIMIT_API=60 per minute

# --- App ---
APP_NAME=Nemvai
# في الإنتاج ضع رابط Render الحقيقي:
FRONTEND_URL=https://nemvai.onrender.com
# محلياً:
# FRONTEND_URL=http://127.0.0.1:5000

# --- Gunicorn/Render ---
# Render يمرر PORT تلقائياً — gunicorn.conf.py يقرأه
PORT=8000
